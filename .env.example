# Supabase (opcional). Sin estas variables la app funciona solo con localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica

# Base de datos PostgreSQL de Supabase (Direct connection, sin pgbouncer)
# Úsalo para migraciones y tareas con Better Auth
DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# Better Auth
BETTER_AUTH_SECRET=tu-clave-secreta-de-32-caracteres-o-más-aquí
BETTER_AUTH_URL=http://localhost:3000

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu-site-key-de-recaptcha
RECAPTCHA_SECRET_KEY=tu-secret-key-de-recaptcha

# Resend (servicio de email gratuito)
# IMPORTANTE: EMAIL_FROM debe usar un dominio verificado en Resend
# (https://resend.com/domains). Si el dominio no está verificado, el registro
# falla de forma cerrada y devuelve 502, y no se enviarán los códigos OTP.
# Mientras el dominio está en verificación, la app reintenta el envío desde
# onboarding@resend.dev (Remitente de pruebas de Resend), que solo entrega al
# correo dueño de la cuenta de Resend. En cuanto el dominio quede verificado,
# ese fallback deja de usarse automáticamente.
RESEND_API_KEY=re_tu_api_key_aqui
EMAIL_FROM=no-reply@tu-dominio-verificado.com

# Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000