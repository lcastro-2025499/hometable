# Variables de entorno de Hometable
#
# Copia este archivo a `.env.local` (ignorado por git) y rellena cada valor.
# Nunca subas `.env.local` al repositorio. En Vercel, configura cada variable
# por separado en Production, Preview y Development; los valores de Production
# no se reutilizan en Preview.

# --- Supabase Realtime -------------------------------------------------------
# Pública (visible en el navegador). URL del proyecto, sin barra final.
# Cliente y servidor. Obligatoria para Realtime: si falta, el tablero sigue
# funcionando con sondeo cada 30 s.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Pública (visible en el navegador). Clave `anon` del proyecto.
# Obligatoria para Realtime. No protege datos por sí sola: el acceso lo limita
# RLS y el JWT de corta duración que firma el servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# --- Base de datos -----------------------------------------------------------
# Secreta. Solo servidor. Obligatoria.
# Usa la cadena del *pooler* de Supabase (host `*.pooler.supabase.com`,
# puerto 6543, modo transaction). Evita agotar las conexiones directas en
# entornos serverless. Si falta, Better Auth y /api/tasks fallan.
DATABASE_URL=postgresql://postgres.[ref]:[password]@[region].pooler.supabase.com:6543/postgres

# Secreta. Solo servidor. Opcional.
# Conexión directa (puerto 5432). Se usa únicamente como respaldo si
# `DATABASE_URL` no está definida, o para migraciones y tareas de
# mantenimiento. En producción no es necesaria.
DIRECT_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# --- Better Auth -------------------------------------------------------------
# Secreta. Solo servidor. Obligatoria. Mínimo 32 caracteres aleatorios.
# Firma las sesiones y la cookie httpOnly que vincula el OTP al navegador.
# Si falta, el registro y la autenticación fallan en tiempo de ejecución.
# Genera una con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-32-caracteres-aleatorios

# URL canónica de la aplicación. Solo servidor. Obligatoria.
# Se usa para las cookies, los enlaces de los correos y los orígenes de
# confianza. En producción debe ser HTTPS y coincidir con el dominio real
# (por ejemplo, https://hometable-tasks.vercel.app). `http://localhost` solo
# se acepta en desarrollo local.
BETTER_AUTH_URL=http://localhost:3000

# --- Google reCAPTCHA v2 -----------------------------------------------------
# Pública (visible en el navegador). Cliente. Obligatoria para el registro.
# Sin ella, el formulario muestra un aviso y el botón de registro queda
# deshabilitado.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu-site-key-de-recaptcha

# Secreta. Solo servidor. Obligatoria para el registro.
# Se valida dentro de /api/auth/register. Si falta o Google rechaza el token,
# el registro responde con error y no se envía ningún código.
RECAPTCHA_SECRET_KEY=tu-secret-key-de-recaptcha

# --- Resend (correo) ---------------------------------------------------------
# Secreta. Solo servidor. Obligatoria para registrar cuentas y restablecer
# contraseñas. Si falta, el registro responde 502 y no crea la cuenta.
RESEND_API_KEY=re_tu_api_key

# Secreta en la práctica (no la expongas). Solo servidor. Obligatoria.
# Debe pertenecer a un dominio verificado en https://resend.com/domains.
# No hay remitente de respaldo: si el dominio no está verificado, el envío
# falla de forma cerrada.
EMAIL_FROM=no-reply@tu-dominio-verificado.com

# --- Supabase Realtime (firma de JWT) ---------------------------------------
# Secreta. Solo servidor. Obligatoria para Realtime.
# Es el *JWT secret* del proyecto (Supabase Dashboard → Project Settings →
# API → JWT Settings). El servidor firma con él un token HS256 de 15 minutos
# con `sub`, `role=authenticated` y `aud=authenticated`. Si falta,
# /api/realtime/token responde 503 y el tablero usa solo sondeo.
# No confundir con la anon key ni con la service role key.
SUPABASE_JWT_SECRET=tu-jwt-secret
